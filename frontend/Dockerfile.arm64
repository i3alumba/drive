# Native builder (amd64 CI by default), with the same Node version on both hosts.
ARG BUILDER_PLATFORM=linux/amd64
FROM --platform=${BUILDER_PLATFORM} node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=optional
COPY . .
RUN npm run build

FROM --platform=linux/arm64 nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
